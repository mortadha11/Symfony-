{% extends 'base.html.twig' %}

{% block title %}List of Books{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>📚 List of Books</h1>

    {% if books is empty %}
        <div class="alert alert-warning mt-3">No Books found 📖</div>
    {% else %}
        <table class="table table-bordered table-striped mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Ref</th>
                    <th>Title</th>
                    <th>Publication Date</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Published</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.id }}</td>
                    <td>{{ book.ref }}</td>
                    <td>{{ book.title }}</td>
                    <td>{{ book.publicationDate ? book.publicationDate|date('Y-m-d') : '—' }}</td>
                    <td>{{ book.category }}</td>
                    <td>{{ book.author.username }}</td>
                    <td>
                        {% if book.published %}
                            <span class="badge bg-success">Yes</span>
                        {% else %}
                            <span class="badge bg-danger">No</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('edit_book', {id: book.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                        <a href="{{ path('delete_book', {id: book.id}) }}" class="btn btn-sm btn-danger"
                           onclick="return confirm('Are you sure you want to delete this book?');">Delete</a>
                        <a href="{{ path('show_book', {id: book.id}) }}" class="btn btn-sm btn-info">Show</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="mt-4">
        <p><strong>📗 Published Books:</strong> {{ publishedCount }}</p>
        <p><strong>📕 Unpublished Books:</strong> {{ unpublishedCount }}</p>
    </div>

    <a href="{{ path('add_book') }}" class="btn btn-primary mt-3">➕ Add New Book</a>
</div>
{% endblock %}
