{% extends 'base.html.twig' %}

{% block title %}Book Details{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>📖 Book Details</h1>

    <table class="table table-striped table-bordered mt-3">
        <tbody>
            <tr>
                <th>ID</th>
                <td>{{ book.id }}</td>
            </tr>
            <tr>
                <th>Reference</th>
                <td>{{ book.ref }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ book.title }}</td>
            </tr>
            <tr>
                <th>Publication Date</th>
                <td>{{ book.publicationDate ? book.publicationDate|date('Y-m-d') : '—' }}</td>
            </tr>
            <tr>
                <th>Category</th>
                <td>{{ book.category }}</td>
            </tr>
            <tr>
                <th>Author</th>
                <td>{{ book.author.username }}</td>
            </tr>
            <tr>
                <th>Published</th>
                <td>
                    {% if book.published %}
                        <span class="badge bg-success">Yes</span>
                    {% else %}
                        <span class="badge bg-danger">No</span>
                    {% endif %}
                </td>
            </tr>
        </tbody>
    </table>

    <div class="mt-4">
        <a href="{{ path('list_books') }}" class="btn btn-secondary">⬅️ Back to List</a>
        <a href="{{ path('edit_book', {id: book.id}) }}" class="btn btn-warning">✏️ Edit</a>
        <a href="{{ path('delete_book', {id: book.id}) }}" class="btn btn-danger"
           onclick="return confirm('Are you sure you want to delete this book?');">🗑️ Delete</a>
    </div>
</div>
{% endblock %}
